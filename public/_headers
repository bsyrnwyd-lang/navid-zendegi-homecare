# Specific asset rules first (most specific to least specific)
# Images - 1 year cache
/assets/*.jpg
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable
  
/assets/*.jpeg
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable
  
/assets/*.png
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable
  
/assets/*.webp
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/assets/*.svg
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

# JavaScript and CSS - 1 year cache
/assets/*.js
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

# All assets folder
/assets/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

# Root level images
/*.jpg
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

# Root level JS and CSS
/*.css
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable

# Fonts
/*.woff2
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable
  Access-Control-Allow-Origin: *

/*.woff
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable
  Access-Control-Allow-Origin: *

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/manifest.json
  Cache-Control: public, max-age=86400
  Content-Type: application/json; charset=utf-8

# Default rule for HTML and other files (must come last)
/*
  # Security headers
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: upgrade-insecure-requests
  
  # Default caching for HTML: short cache to allow updates
  Cache-Control: public, max-age=300, must-revalidate
  Vary: Accept-Encoding
